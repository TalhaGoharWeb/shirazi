# ── SHIRAZI environment template ──────────────────────────────────────────────
# Copy to `.env` (git-ignored) and fill in. NEVER commit a real `.env`.
# Phase 3 note: the app currently reads secrets from config/api_keys.json
# (written by the first-run setup screen). These variables are the forward
# path for Phase 4's encrypted/provider-aware config — nothing reads them yet.

# Primary AI provider key (free Gemini API key)
GEMINI_API_KEY=

# Optional free-tier fallbacks (Phase 4)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Branding / identity overrides (optional; defaults live in config/settings.json)
SHIRAZI_ASSISTANT_NAME=SHIRAZI
